APP_NAME="Forus Freight"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://forusfl.co.zm

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=forusflco_forus
DB_USERNAME=forusflco_user
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database

MAIL_MAILER=brevo
MAIL_FROM_ADDRESS="noreply@forusfl.co.zm"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

VITE_APP_NAME="${APP_NAME}"

# Brevo Transactional Email
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE
BREVO_SENDER_EMAIL=noreply@forusfl.co.zm
BREVO_SENDER_NAME="Forus Freight"

# Brevo SMTP Relay (fallback when HTTP API is blocked by IP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_ENCRYPTION=tls
BREVO_SMTP_LOGIN=noreply@forusfl.co.zm
BREVO_SMTP_KEY=YOUR_BREVO_SMTP_KEY_HERE

# Molo Marketing Cloud SMS
MOLO_EMAIL=your-email@example.com
MOLO_PASSWORD=YOUR_MOLO_PASSWORD_HERE
MOLO_SMS_ORIGINATOR=FORUSFL
MOLO_SMS_URL=https://api.molomarketing.cloud

# Green API WhatsApp
GREEN_API_INSTANCE_ID=YOUR_GREEN_API_INSTANCE_ID_HERE
GREEN_API_TOKEN=YOUR_GREEN_API_TOKEN_HERE
GREEN_API_BASE_URL=https://api.green-api.com
