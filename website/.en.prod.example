APP_NAME="Forus Freight"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://forusfl.co.zm

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=forusflco_forus
DB_USERNAME=forusflco_user
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_FROM_ADDRESS=noreply@forusfl.co.zm
MAIL_FROM_NAME="Forus Freight"

BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE
BREVO_SENDER_EMAIL=noreply@forusfl.co.zm
BREVO_SENDER_NAME="Forus Freight"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

VITE_APP_NAME="${APP_NAME}"

MOLO_EMAIL=forusfreight@gmail.com
MOLO_PASSWORD=YOUR_MOLO_PASSWORD_HERE
MOLO_SMS_ORIGINATOR=FORUSFL
MOLO_SMS_URL=https://api.molomarketing.cloud

