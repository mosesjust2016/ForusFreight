cachePath
/vendor
Homestead.json
Homestead.yaml

# ---- Laravel (website/) ----
website/.env
website/.env.*
website/.env.backup
website/vendor/
website/node_modules/
website/public/hot
website/public/storage
website/storage/*.key
website/storage/app/public/*
website/storage/framework/cache/*
