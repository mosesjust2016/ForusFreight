website/storage/framework/views/*
website/storage/logs/*
website/bootstrap/cache/*.php
website/cachePath

# ---- Node / JS (Ecommerce/ etc.) ----
Ecommerce/node_modules/
TerraForm/node_modules/
node_modules/

# ---- Build outputs ----
