# ============================================================
# ForusFreight – Root .gitignore
# ============================================================

# ---- Laravel (website/) ----
website/.env
website/.env.*
website/.env.backup
website/vendor/
website/node_modules/
website/public/hot
website/public/storage
website/storage/*.key
website/storage/app/public/*
website/storage/framework/cache/*
website/storage/framework/sessions/*
website/storage/framework/views/*
website/storage/logs/*
website/bootstrap/cache/*.php
website/cachePath

# ---- Node / JS (Ecommerce/ etc.) ----
Ecommerce/node_modules/
TerraForm/node_modules/
node_modules/

# ---- Build outputs ----
website/public/build/
dist/
build/

# ---- OS / Editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.suo

# ---- Misc ----
*.log
*.zip
*.tar.gz
.env
